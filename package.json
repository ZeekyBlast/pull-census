{
  "name": "pull-census",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26.11"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"scripts/*.test.ts\"",
    "test:slow": "SLOW=1 node --test \"packages/core/test/sim/*.slow.test.ts\"",
    "typecheck": "tsc -p packages/core --noEmit",
    "lint": "biome check .",
    "calibrate": "node scripts/calibrate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
